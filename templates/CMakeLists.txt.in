cmake_minimum_required(VERSION 3.22)
project(@@TARGET@@ VERSION 0.1.0 LANGUAGES C CXX)

if(NOT WIN32)
  message(FATAL_ERROR "SkellForge v0.1 targets Windows VST3 only")
endif()

include(FetchContent)
if(DEFINED JUCE_PATH AND EXISTS "${JUCE_PATH}/CMakeLists.txt")
  add_subdirectory("${JUCE_PATH}" "${CMAKE_BINARY_DIR}/juce")
else()
  FetchContent_Declare(JUCE GIT_REPOSITORY https://github.com/juce-framework/JUCE.git
    GIT_TAG 8.0.12 GIT_SHALLOW TRUE)
  FetchContent_MakeAvailable(JUCE)
endif()

if(DEFINED SKELLCORE_PATH AND EXISTS "${SKELLCORE_PATH}/SkellCore/CMakeLists.txt")
  add_subdirectory("${SKELLCORE_PATH}/SkellCore" "${CMAKE_BINARY_DIR}/skellcore")
elseif(DEFINED SKELLCORE_PATH AND EXISTS "${SKELLCORE_PATH}/CMakeLists.txt")
  add_subdirectory("${SKELLCORE_PATH}" "${CMAKE_BINARY_DIR}/skellcore")
else()
  FetchContent_Declare(SkellCore
    GIT_REPOSITORY @@CORE_REPO@@
    GIT_TAG @@CORE_REV@@
    SOURCE_SUBDIR SkellCore)
  FetchContent_MakeAvailable(SkellCore)
endif()

juce_add_plugin(@@TARGET@@
  COMPANY_NAME "Skell Audio"
  BUNDLE_ID "@@BUNDLE@@"
  PLUGIN_MANUFACTURER_CODE SkAu
  PLUGIN_CODE @@CODE@@
  FORMATS VST3
  PRODUCT_NAME "@@NAME@@"
  IS_SYNTH FALSE
  NEEDS_MIDI_INPUT FALSE
  NEEDS_MIDI_OUTPUT FALSE
  IS_MIDI_EFFECT FALSE
  COPY_PLUGIN_AFTER_BUILD FALSE)
juce_generate_juce_header(@@TARGET@@)
target_sources(@@TARGET@@ PRIVATE
  Source/PluginProcessor.h Source/PluginProcessor.cpp
  Source/PluginEditor.h Source/PluginEditor.cpp
  Source/ForgeGraph.h Source/ForgeUI.h Source/ForgeParameters.h)
target_compile_features(@@TARGET@@ PRIVATE cxx_std_17)
target_compile_definitions(@@TARGET@@ PRIVATE
  JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0 JUCE_VST3_CAN_REPLACE_VST2=0)
target_link_libraries(@@TARGET@@ PRIVATE
  SkellCore::DSP SkellCore::UI
  juce::juce_audio_utils juce::juce_audio_processors juce::juce_gui_extra)

# Optional real C++ offline DSP fixtures, independent from FL Studio.
option(SKELLFORGE_BUILD_DSP_TESTS "Build and run Forge-generated JUCE DSP fixtures" OFF)
if(SKELLFORGE_BUILD_DSP_TESTS)
  enable_testing()
  add_executable(SkellForgeDspSmoke tests/ForgeDspSmoke.cpp)
  target_include_directories(SkellForgeDspSmoke PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/Source")
  target_compile_features(SkellForgeDspSmoke PRIVATE cxx_std_17)
  target_compile_definitions(SkellForgeDspSmoke PRIVATE
    JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0 JUCE_VST3_CAN_REPLACE_VST2=0)
  target_link_libraries(SkellForgeDspSmoke PRIVATE
    juce::juce_audio_processors juce::juce_audio_basics juce::juce_core)
  add_test(NAME SkellForgeDspSmoke COMMAND SkellForgeDspSmoke)
endif()

# Optional real-editor preview. Uses the SAME processor/editor sources as the
# generated VST3. Explicit target: excluded from ordinary plugin builds.
option(SKELLFORGE_BUILD_UI_PREVIEW "Build actual JUCE editor screenshot tool" OFF)
if(SKELLFORGE_BUILD_UI_PREVIEW)
  juce_add_console_app(SkellForgeUiPreview PRODUCT_NAME "SkellForgeUiPreview")
  juce_generate_juce_header(SkellForgeUiPreview)
  target_sources(SkellForgeUiPreview PRIVATE
    tests/ForgeUIRender.cpp
    Source/PluginProcessor.h Source/PluginProcessor.cpp
    Source/PluginEditor.h Source/PluginEditor.cpp
    Source/ForgeGraph.h Source/ForgeUI.h Source/ForgeParameters.h)
  target_compile_features(SkellForgeUiPreview PRIVATE cxx_std_17)
  target_compile_definitions(SkellForgeUiPreview PRIVATE
    JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0 JUCE_VST3_CAN_REPLACE_VST2=0)
  target_link_libraries(SkellForgeUiPreview PRIVATE
    SkellCore::DSP SkellCore::UI SkellCore::UIRenderer
    juce::juce_audio_utils juce::juce_audio_processors juce::juce_gui_extra)
  # Built only when explicitly requested; avoids slowing normal local builds.
  set_target_properties(SkellForgeUiPreview PROPERTIES EXCLUDE_FROM_ALL TRUE)
endif()
