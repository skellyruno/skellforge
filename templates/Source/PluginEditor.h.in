#pragma once
#include <JuceHeader.h>
#include <SkellCore/StudioUI.h>
#include "PluginProcessor.h"

class @@TARGET@@AudioProcessorEditor final : public juce::AudioProcessorEditor {
public:
    explicit @@TARGET@@AudioProcessorEditor(@@TARGET@@AudioProcessor&);
    ~@@TARGET@@AudioProcessorEditor() override;
    void paint(juce::Graphics&) override;
    void resized() override;
private:
    struct ThemeButton final : juce::Button {
        ThemeButton() : juce::Button("Theme") {
            setMouseCursor(juce::MouseCursor::PointingHandCursor);
            setWantsKeyboardFocus(true);
            setTooltip("Click to change the theme");
        }
        void paintButton(juce::Graphics& g, bool isMouseOver, bool isButtonDown) override {
            if (isMouseOver || isButtonDown) {
                g.setColour(juce::Colours::white.withAlpha(isButtonDown ? 0.14f : 0.07f));
                g.fillRoundedRectangle(getLocalBounds().toFloat().reduced(2.0f), 5.0f);
            }
            if (hasKeyboardFocus(true)) {
                g.setColour(juce::Colours::white.withAlpha(0.9f));
                g.drawRoundedRectangle(getLocalBounds().toFloat().reduced(2.0f), 5.0f, 2.0f);
            }
        }
    };
    void changeSkin();
    skellcore::ui::StudioLookAndFeel skin_{skellcore::ui::StudioSkin::Obsidian};
    ThemeButton themeButton_;
    juce::Label title_;
    juce::Label gainLabel_;
    juce::Slider gainKnob_;
    juce::AudioProcessorValueTreeState::SliderAttachment gainAttachment_;
    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR(@@TARGET@@AudioProcessorEditor)
};
